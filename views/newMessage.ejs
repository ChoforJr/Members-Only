<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head')%>
  <body>
    <a href="/">HomePage</a>
    <h2>Create New Message</h2>
    <form action="/create-new-message" method="POST">
      <label for="title">Title: </label>
      <input
        id="title"
        name="title"
        placeholder="Title"
        type="text"
        value="<%= title %>"
      />
      <label for="text">Message: </label>
      <textarea
        name="text"
        id="text"
        placeholder="Message"
        value="<%= text %>"
      ></textarea>
      <button type="submit">Create</button>
    </form>
    <% if (locals.errors) {%> <%- include('partials/errors',{errors}) %> <% } %>
  </body>
</html>
